# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Puerto de la API
ARCA_API_PORT=8000
ARCA_TEAM=Equipo1
ARCA_DOMAIN=asistente_enfermeria

# - Hugging Face
# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# - Fase 1: razonamiento (endpoint /reasoning)
ARCA_RLM_ADAPTER=rlm/weights/final_rlm_lora_sin_kl
ARCA_RLM_BASE_MODEL=Qwen/Qwen3-0.6B
ARCA_RLM_VERIFIER=medication

# - Repos del Hub
# Adaptador SFT del que parte train_grpo.py si no existe en local
ARCA_SFT_REPO=raquelfes11/dgm-arca-sft-lora

# Adaptador GRPO - Mejor modelo de la Fase 1
ARCA_RLM_ADAPTER_REPO=isamorell/dgm-arca-rlm-lora-sin-kl
